{
  // Webflow Cloud provisions the D1 database from this binding at deploy;
  // database_id below is used for local `wrangler dev` only.
  "name": "popfly-identity",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "popfly_identity",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
